# Core app metadata
PROJECT_NAME=SalesOS
ENVIRONMENT=development
LOG_LEVEL=INFO

# API container and routing
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://api:8000
API_REQUEST_TIMEOUT_SECONDS=30

# Dashboard and bot ports
DASHBOARD_PORT=3000
TELEGRAM_BOT_PORT=8080
TELEGRAM_BOT_INTERNAL_URL=http://telegram-bot:8080

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=salesos
POSTGRES_USER=salesos
POSTGRES_PASSWORD=salesos

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_OPERATION_TIMEOUT_SECONDS=5
REDIS_RETRY_ATTEMPTS=2

# Local Windows Ollama accessed from Docker via host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CLASSIFICATION_MODEL=phi3
OLLAMA_SECONDARY_CLASSIFICATION_MODEL=phi3
OLLAMA_REASONING_MODEL=gemma2:2b
OLLAMA_PERSONALIZATION_MODEL=phi3
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_RETRY_ATTEMPTS=2
OLLAMA_KEEP_ALIVE=10m
OLLAMA_WARMUP_ENABLED=false

# Telegram
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_USE_WEBHOOKS=false
TELEGRAM_WEBHOOK_SECRET=replace-me
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ALERT_CHAT_IDS=123456789
TELEGRAM_BASE_URL=
INTERNAL_SERVICE_TOKEN=local-dev-token

# Startup and diagnostics
STARTUP_STRICT_VALIDATION=false
STARTUP_GRACE_PERIOD_SECONDS=45
STARTUP_DEPENDENCY_TIMEOUT_SECONDS=60
STARTUP_DEPENDENCY_RETRY_ATTEMPTS=12
STARTUP_DEPENDENCY_POLL_SECONDS=2

# Optional scrape defaults
APIFY_TOKEN=replace-me
APIFY_GOOGLE_MAPS_ACTOR_ID=compass~google-maps-scraper
APIFY_TIMEOUT_SECONDS=30
APIFY_RETRY_ATTEMPTS=2
DEFAULT_SCRAPE_QUERY=marketing agency
DEFAULT_SCRAPE_LOCATION=Austin, TX
DEFAULT_SCRAPE_MAX_RESULTS=5
DEFAULT_TIMEZONE=Asia/Calcutta
PROCESS_EXISTING_LEADS=true
OUTREACH_COOLDOWN_HOURS=24
REVIEW_SIGNAL_MIN_SEVERITY=65
REVIEW_SIGNAL_ALERT_THRESHOLD=75
REVIEW_SIGNAL_AI_REFINEMENT_ENABLED=true
